n  14 |     // eslint-disable-next-line react-hooks/set-state-in-effect\n> 15 |     setIsLoggedIn(!!token);\n     |     ^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  16 |   }, []);\n  17 |\n  18 |   const handleLogout = () => {",["91"],{"kind":"92","justification":"93"},"directive",""]