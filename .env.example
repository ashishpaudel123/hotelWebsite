# =============================================================================
# HOTEL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it contains sensitive secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# Environment: development | staging | production
NODE_ENV=production

# Server port
PORT=5000

# Frontend application URL (used for CORS and redirects)
FRONTEND_URL=https://yourhotel.com

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (MongoDB)
# -----------------------------------------------------------------------------
# Format: mongodb://username:password@host:port/database?options
# For production, use MongoDB Atlas or a managed database service
MONGODB_URI=mongodb://localhost:27017/hotel-management?authSource=admin

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION CONFIGURATION
# -----------------------------------------------------------------------------
# CRITICAL: Use strong, random secrets (minimum 32 characters)
# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-32-character-secret-key-minimum
JWT_EXPIRES_IN=15m

# Refresh token for extended sessions
REFRESH_TOKEN_SECRET=change-this-to-another-random-32-char-secret-key
REFRESH_TOKEN_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
# Log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# RATE LIMITING (Security)
# -----------------------------------------------------------------------------
# Time window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins (no spaces after commas)
CORS_ORIGINS=https://yourhotel.com,https://admin.yourhotel.com

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (SMTP)
# Required for: Password reset, booking confirmations, notifications
# -----------------------------------------------------------------------------
# For Gmail: Use App Password, not regular password
# For SendGrid: smtp.sendgrid.net:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for port 465, false for port 587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-or-smtp-password
SMTP_FROM_EMAIL=noreply@yourhotel.com
SMTP_FROM_NAME=Hotel Management System

# -----------------------------------------------------------------------------
# SMS CONFIGURATION (Optional)
# Required for: Booking confirmations, OTP verification
# -----------------------------------------------------------------------------
SMS_GATEWAY_URL=https://api.smsprovider.com/send
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=HOTELNAME

# -----------------------------------------------------------------------------
# ESEWA PAYMENT GATEWAY CONFIGURATION (Nepal)
# -----------------------------------------------------------------------------
# Test credentials available at: https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_MERCHANT_CODE=TESTMERCHCODE
ESEWA_SECRET_KEY=your-esewa-secret-key-from-esewa-dashboard
# test | production
ESEWA_ENV=test

# URLs for payment flow
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_VERIFICATION_URL=https://rc-epay.esewa.com.np/api/epay/transaction/status/
ESEWA_SUCCESS_URL=https://yourhotel.com/payment/success
ESEWA_FAILURE_URL=https://yourhotel.com/payment/failure

# -----------------------------------------------------------------------------
# KHALTI PAYMENT GATEWAY CONFIGURATION (Nepal)
# -----------------------------------------------------------------------------
# Get keys from: https://dashboard.khalti.com/
KHALTI_PUBLIC_KEY=your-khalti-public-key
KHALTI_SECRET_KEY=your-khalti-secret-key-from-dashboard
# test | production
KHALTI_ENV=test

# URLs for payment flow
KHALTI_INITIATION_URL=https://a.khalti.com/api/v2/epayment/initiate/
KHALTI_VERIFICATION_URL=https://a.khalti.com/api/v2/epayment/lookup/
KHALTI_WEBSITE_URL=https://yourhotel.com
KHALTI_SUCCESS_URL=https://yourhotel.com/payment/success

# -----------------------------------------------------------------------------
# CLOUD STORAGE (Optional - for room images, documents)
# -----------------------------------------------------------------------------
# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_BUCKET_NAME=your-hotel-images-bucket
AWS_REGION=us-east-1

# Alternative: Cloudinary, Firebase Storage, etc.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# -----------------------------------------------------------------------------
# MONITORING & ANALYTICS (Optional but Recommended)
# -----------------------------------------------------------------------------
# Error tracking with Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# Google Analytics for frontend
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# SESSION CONFIGURATION (Optional - if using session-based auth)
# -----------------------------------------------------------------------------
SESSION_SECRET=your-session-secret-key-min-32-characters

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION (Optional - for caching, rate limiting)
# -----------------------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# -----------------------------------------------------------------------------
# FILE UPLOAD CONFIGURATION
# -----------------------------------------------------------------------------
# Maximum file size in bytes (e.g., 5MB = 5242880)
MAX_FILE_SIZE=5242880
# Allowed file types for uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
# Bcrypt salt rounds for password hashing (10-14 recommended)
BCRYPT_SALT_ROUNDS=12

# Password reset token expiry in minutes
PASSWORD_RESET_TOKEN_EXPIRY=60

# Email verification token expiry in minutes
EMAIL_VERIFICATION_TOKEN_EXPIRY=1440
